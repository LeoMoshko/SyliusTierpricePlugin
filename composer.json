{
    "name": "leomoshko/sylius-tierprice-plugin",
    "type": "sylius-plugin",
    "description": "A plugin that allows to add tierprices to Sylius (fork of brille24/sylius-tierprice-plugin)",
    "keywords": ["sylius", "sylius-plugin", "tier price", "tierprice", "pricing"],
    "license": "MIT",
    "authors": [
        {
            "name": "Leonid Moshko",
            "email": "leomoshko@gmail.com"
        },
        {
            "name": "Brille24 GmbH",
            "homepage": "https://github.com/Brille24/SyliusTierpricePlugin/graphs/contributors"
        }
    ],
    "homepage": "https://github.com/LeoMoshko/SyliusTierpricePlugin",
    "support": {
        "issues": "https://github.com/LeoMoshko/SyliusTierpricePlugin/issues",
        "source": "https://github.com/LeoMoshko/SyliusTierpricePlugin"
    },
    "require": {
        "php": "^8.2",
        "sylius/sylius": ">=2.0 <2.3"
    },
    "require-dev": {
        "behat/behat": "^3.16",
        "cweagans/composer-patches": "^1.7",
        "dmore/behat-chrome-extension": "^1.4",
        "dmore/chrome-mink-driver": "^2.9",
        "friends-of-behat/mink": "^1.11",
        "friends-of-behat/mink-browserkit-driver": "^1.6",
        "friends-of-behat/mink-debug-extension": "^2.1",
        "friends-of-behat/mink-extension": "^2.7",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/suite-settings-extension": "^1.1",
        "friends-of-behat/symfony-extension": ">=2.6.2 <2.7",
        "friends-of-behat/variadic-extension": "^1.6",
        "nyholm/psr7": "^1.8",
        "phpspec/phpspec": "^7.5",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-doctrine": "^1.3",
        "phpstan/phpstan-webmozart-assert": "^1.2",
        "phpunit/phpunit": "^10.5",
        "robertfausk/behat-panther-extension": "^1.1",
        "sylius-labs/coding-standard": "^4.4",
        "sylius-labs/suite-tags-extension": "~0.2",
        "sylius/sylius-rector": "^1.0",
        "symfony/browser-kit": "^6.4 || ^7.1",
        "symfony/debug-bundle": "^6.4 || ^7.1",
        "symfony/dotenv": "^6.4 || ^7.1",
        "symfony/flex": "^2.4",
        "symfony/http-client": "^6.4 || ^7.1",
        "symfony/intl": "^6.4 || ^7.1",
        "symfony/web-profiler-bundle": "^6.4 || ^7.1",
        "symfony/webpack-encore-bundle": "^2.2"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.99"
        },
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "phpstan/extension-installer": false,
            "symfony/flex": false,
            "symfony/thanks": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        },
        "symfony": {
            "require": "^6.4"
        },
        "patches": {
            "symfony/type-info": {
                "Catch invalid @template bounds (Loggable|object) during cache warmup": "patches/symfony-type-info-catch-invalid-template-bound.patch"
            }
        }
    },
    "autoload": {
        "psr-4": {
            "Brille24\\SyliusTierPricePlugin\\": "src/",
            "Tests\\Brille24\\SyliusTierPricePlugin\\": "tests/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-update-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-create-project-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "security-checker security:check": "script"
        },
        "analyse": [
            "vendor/bin/ecs check --ansi --no-progress-bar --config ecs.php",
            "vendor/bin/phpstan analyse -c phpstan.neon --no-progress -l max src/"
        ],
        "fix": [
            "vendor/bin/ecs check --ansi --no-progress-bar --config ecs.php --fix"
        ]
    }
}
